<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Build an OCI image with no Dockerfile: dotnet publish -t:PublishContainer -->
    <ContainerRepository>container-demo</ContainerRepository>
    <ContainerImageTag>1.0.0</ContainerImageTag>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:8.0-jammy-chiseled</ContainerBaseImage>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>
</Project>
